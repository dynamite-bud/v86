#!/bin/sh

# Readiness contract for the multi-core Ghostty/Codex appliance.
#
# This is the XWAH-9 SMP line's own appliance. It deliberately does NOT
# share an image name with tools/docker/virtio-gpu-alpine-codex: both
# branches build into the same (symlinked, gitignored) images/ directory,
# so a shared prefix means whichever branch built last silently wins and
# the other branch boots a guest it never described. V86_APPLIANCE_IMAGE
# below exists so that mix-up is visible in the first lines of serial
# output instead of being diagnosed from a package list.
#
# Beyond the graphical contract inherited from the single-core appliance
# (Xorg + Openbox + Ghostty + a live Codex process over llvmpipe), this one
# proves the thing the SMP work exists for: that the guest actually brought
# up every vCPU and that they run in parallel. Reaching a shell on one CPU
# is not a pass here.

exec 3>/dev/ttyS0

fail()
{
    reason=$1
    [ ! -f /tmp/v86-appliance.log ] || tail -n 200 /tmp/v86-appliance.log >&3
    [ ! -f /tmp/v86-glxinfo.log ] || tail -n 200 /tmp/v86-glxinfo.log >&3
    printf 'V86_APPLIANCE_FAILURE=%s\n' "$reason" >&3
    printf 'V86_APPLIANCE_READY=FAIL\nV86_APPLIANCE_END\n' >&3
    exit 1
}

# Seconds since boot as a float; busybox date has no portable %N.
now()
{
    cut -d' ' -f1 /proc/uptime
}

# One unit of pure-CPU work. Integer-only and allocation-free on purpose,
# so the measurement below reflects vCPU throughput rather than the
# allocator, the 9p root, or the GPU.
busy()
{
    awk 'BEGIN { s = 0; for(i = 0; i < 300000; i++) { s += i % 7 } }'
}

printf 'V86_APPLIANCE_BEGIN\n' >&3
printf 'V86_APPLIANCE_IMAGE=multicore-ghostty-codex\n' >&3
printf 'V86_APPLIANCE_ARCH=%s\n' "$(uname -m)" >&3
printf 'V86_APPLIANCE_UID=%s\n' "$(id -u)" >&3
hostname_value=$(hostname)
printf 'V86_APPLIANCE_HOSTNAME=%s\n' "$hostname_value" >&3
printf 'V86_APPLIANCE_KERNEL=%s\n' "$(uname -r)" >&3

[ "$(uname -m)" = i686 ] || fail wrong-architecture
[ "$(id -u)" = 1000 ] || fail privileged-session
[ "$hostname_value" = v86-appliance ] || fail hostname

# ---- SMP evidence (the reason this appliance exists) ----
#
# nproc is what the guest kernel actually brought online: SeaBIOS's
# INIT-SIPI-SIPI has to have started every AP and Linux has to have
# scheduled it. Under worker-per-vCPU execution each of those is its own
# host thread, so a shortfall here is a real bring-up failure.
online_cpus=$(nproc)
printf 'V86_APPLIANCE_CPUS=%s\n' "$online_cpus" >&3

# The launcher passes the vCPU count it configured; without it we can only
# report what we found.
expected_cpus=$(sed -n 's/.*v86_cpus=\([0-9][0-9]*\).*/\1/p' /proc/cmdline)
if [ -n "$expected_cpus" ]; then
    printf 'V86_APPLIANCE_CPUS_EXPECTED=%s\n' "$expected_cpus" >&3
    [ "$online_cpus" = "$expected_cpus" ] || fail cpu-count-mismatch
fi

if [ "$online_cpus" -gt 1 ]; then
    serial_start=$(now)
    busy
    serial_end=$(now)

    parallel_start=$(now)
    i=0
    while [ "$i" -lt "$online_cpus" ]; do
        busy &
        i=$((i + 1))
    done
    wait
    parallel_end=$(now)

    # speedup = n * serial_elapsed / parallel_elapsed: n units of the same
    # work done concurrently, priced against one unit done alone.
    speedup=$(awk -v s="$serial_start" -v se="$serial_end" \
                  -v p="$parallel_start" -v pe="$parallel_end" \
                  -v n="$online_cpus" \
        'BEGIN { st = se - s; pt = pe - p;
                 if(st <= 0 || pt <= 0) { print "0.00" }
                 else { printf "%.2f", n * st / pt } }')
    printf 'V86_APPLIANCE_PARALLEL_SPEEDUP=%s\n' "$speedup" >&3

    # A deliberately loose bar. Real worker-per-vCPU execution measures far
    # above it; time-sliced execution cannot exceed ~1.0 however the host is
    # loaded, so this separates the two without being a performance gate.
    # Graded rather than fatal: a saturated host can depress the number
    # without anything being wrong with the guest.
    if awk -v v="$speedup" 'BEGIN { exit !(v >= 1.30) }'; then
        printf 'V86_APPLIANCE_PARALLEL=PASS\n' >&3
    else
        printf 'V86_APPLIANCE_PARALLEL=WEAK\n' >&3
    fi
else
    printf 'V86_APPLIANCE_PARALLEL=SINGLE\n' >&3
fi

ghostty_version=$(ghostty --version 2>/dev/null | head -n 1) || fail ghostty-version
codex_version=$(codex --version 2>/dev/null) || fail codex-version
printf 'V86_APPLIANCE_GHOSTTY=%s\n' "$ghostty_version" >&3
printf 'V86_APPLIANCE_CODEX=%s\n' "$codex_version" >&3

attempt=0
while [ "$attempt" -lt 100 ]; do
    [ -e /dev/dri/card0 ] && break
    sleep 0.1
    attempt=$((attempt + 1))
done
[ -e /dev/dri/card0 ] || fail drm-missing
printf 'V86_APPLIANCE_DRM=/dev/dri/card0\n' >&3

if grep -qw 'v86_relay=unconfigured' /proc/cmdline; then
    printf 'V86_APPLIANCE_NETWORK=UNCONFIGURED\n' >&3
elif [ -e /run/v86-network-ready ] &&
     ip -4 addr show dev eth0 2>/dev/null | grep -q 'inet '; then
    printf 'V86_APPLIANCE_NETWORK=PASS\n' >&3
else
    [ ! -f /var/log/v86-networking.log ] || cat /var/log/v86-networking.log >&3
    fail network-unavailable
fi

[ -d /run/user/1000 ] && [ -w /run/user/1000 ] || fail runtime-directory
export HOME=/home/codex
export USER=codex
export LOGNAME=codex
export XDG_RUNTIME_DIR=/run/user/1000
export XDG_CURRENT_DESKTOP=OPENBOX
export XDG_SESSION_DESKTOP=openbox
export XDG_SESSION_TYPE=x11
export LIBGL_ALWAYS_SOFTWARE=1
export GSK_RENDERER=gl

rm -f /tmp/v86-appliance-ui-ready /tmp/v86-appliance-gl-ready \
      /tmp/v86-appliance-tui-ready
startx -- :0 vt1 -keeptty -nolisten tcp >/tmp/v86-appliance.log 2>&1 &
session_pid=$!

attempt=0
while [ "$attempt" -lt 900 ]; do
    kill -0 "$session_pid" 2>/dev/null || break
    # tui-ready is the addition over the single-core contract: Codex having
    # a pid only proves it was spawned, not that it drew anything. See
    # codex-session for what earns that marker.
    if [ -e /tmp/v86-appliance-gl-ready ] &&
       [ -e /tmp/v86-appliance-ui-ready ] &&
       [ -e /tmp/v86-appliance-tui-ready ] &&
       [ -S /tmp/.X11-unix/X0 ] &&
       pidof openbox >/dev/null &&
       pidof ghostty >/dev/null &&
       pidof codex >/dev/null; then
        renderer=$(sed -n 's/^OpenGL renderer string: //p' /tmp/v86-glxinfo.log | head -n 1)
        opengl_version=$(sed -n 's/^OpenGL version string: //p' /tmp/v86-glxinfo.log | head -n 1)
        printf 'V86_APPLIANCE_XORG=PASS\n' >&3
        printf 'V86_APPLIANCE_RENDERER=%s\n' "$renderer" >&3
        printf 'V86_APPLIANCE_OPENGL=%s\n' "$opengl_version" >&3
        printf 'V86_APPLIANCE_OPENBOX=PASS\n' >&3
        printf 'V86_APPLIANCE_GHOSTTY_PROCESS=PASS\n' >&3
        printf 'V86_APPLIANCE_GHOSTTY_WINDOW=PASS\n' >&3
        printf 'V86_APPLIANCE_CODEX_PROCESS=PASS\n' >&3
        printf 'V86_APPLIANCE_CODEX_TUI=PASS\n' >&3
        printf 'V86_APPLIANCE_READY=PASS\nV86_APPLIANCE_END\n' >&3
        wait "$session_pid"
        exit $?
    fi
    sleep 0.1
    attempt=$((attempt + 1))
done

fail session-startup
