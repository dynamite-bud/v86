#!/bin/sh

exec 3>/dev/ttyS0

fail()
{
    reason=$1
    for log in /tmp/v86-alacritty-appliance.log /tmp/v86-alacritty-openbox.log \
        /tmp/v86-alacritty-glxinfo.log /tmp/v86-alacritty.log; do
        [ ! -f "$log" ] || tail -n 160 "$log" >&3
    done
    printf 'V86_ALACRITTY_CODEX_FAILURE=%s\n' "$reason" >&3
    printf 'V86_ALACRITTY_CODEX_READY=FAIL\nV86_ALACRITTY_CODEX_END\n' >&3
    exit 1
}

printf 'V86_ALACRITTY_CODEX_BEGIN\n' >&3
printf 'V86_ALACRITTY_CODEX_ARCH=%s\n' "$(uname -m)" >&3
printf 'V86_ALACRITTY_CODEX_UID=%s\n' "$(id -u)" >&3
hostname_value=$(hostname)
printf 'V86_ALACRITTY_CODEX_HOSTNAME=%s\n' "$hostname_value" >&3
printf 'V86_ALACRITTY_CODEX_KERNEL=%s\n' "$(uname -r)" >&3

[ "$(uname -m)" = i686 ] || fail wrong-architecture
[ "$(id -u)" = 1000 ] || fail privileged-session
[ "$hostname_value" = v86-appliance ] || fail hostname

alacritty_version=$(alacritty --version 2>/dev/null) || fail alacritty-version
codex_version=$(codex --version 2>/dev/null) || fail codex-version
printf 'V86_ALACRITTY_CODEX_ALACRITTY=%s\n' "$alacritty_version" >&3
printf 'V86_ALACRITTY_CODEX_CODEX=%s\n' "$codex_version" >&3

attempt=0
while [ "$attempt" -lt 100 ]; do
    [ -e /dev/dri/card0 ] && break
    sleep 0.1
    attempt=$((attempt + 1))
done
[ -e /dev/dri/card0 ] || fail drm-missing
printf 'V86_ALACRITTY_CODEX_DRM=/dev/dri/card0\n' >&3

if grep -qw 'v86_relay=unconfigured' /proc/cmdline; then
    printf 'V86_ALACRITTY_CODEX_NETWORK=UNCONFIGURED\n' >&3
elif [ -e /run/v86-network-ready ] &&
     ip -4 addr show dev eth0 2>/dev/null | grep -q 'inet '; then
    printf 'V86_ALACRITTY_CODEX_NETWORK=PASS\n' >&3
else
    [ ! -f /var/log/v86-networking.log ] || cat /var/log/v86-networking.log >&3
    fail network-unavailable
fi

[ -d /run/user/1000 ] && [ -w /run/user/1000 ] || fail runtime-directory
export HOME=/home/codex
export USER=codex
export LOGNAME=codex
export XDG_RUNTIME_DIR=/run/user/1000
export XDG_CURRENT_DESKTOP=OPENBOX
export XDG_SESSION_DESKTOP=openbox
export XDG_SESSION_TYPE=x11
export LIBGL_ALWAYS_SOFTWARE=1

rm -f /tmp/v86-alacritty-ui-ready /tmp/v86-alacritty-gl-ready
: > /tmp/v86-alacritty-appliance.log
startx -- :0 vt1 -keeptty -nolisten tcp >/tmp/v86-alacritty-appliance.log 2>&1 &
session_pid=$!

attempt=0
while [ "$attempt" -lt 1200 ]; do
    kill -0 "$session_pid" 2>/dev/null || break
    if [ -e /tmp/v86-alacritty-gl-ready ] &&
       [ -e /tmp/v86-alacritty-ui-ready ] &&
       [ -S /tmp/.X11-unix/X0 ] &&
       pidof openbox >/dev/null &&
       pidof alacritty >/dev/null &&
       pidof codex >/dev/null; then
        renderer=$(sed -n 's/^OpenGL renderer string: //p' \
            /tmp/v86-alacritty-glxinfo.log | head -n 1)
        opengl_version=$(sed -n 's/^OpenGL version string: //p' \
            /tmp/v86-alacritty-glxinfo.log | head -n 1)
        [ -n "$renderer" ] || fail renderer-missing
        [ -n "$opengl_version" ] || fail opengl-version-missing
        printf 'V86_ALACRITTY_CODEX_XORG=PASS\n' >&3
        printf 'V86_ALACRITTY_CODEX_RENDERER=%s\n' "$renderer" >&3
        printf 'V86_ALACRITTY_CODEX_OPENGL=%s\n' "$opengl_version" >&3
        printf 'V86_ALACRITTY_CODEX_OPENBOX=PASS\n' >&3
        printf 'V86_ALACRITTY_CODEX_ALACRITTY_PROCESS=PASS\n' >&3
        printf 'V86_ALACRITTY_CODEX_ALACRITTY_WINDOW=MAXIMIZED\n' >&3
        printf 'V86_ALACRITTY_CODEX_CODEX_PROCESS=PASS\n' >&3
        printf 'V86_ALACRITTY_CODEX_READY=PASS\nV86_ALACRITTY_CODEX_END\n' >&3
        wait "$session_pid"
        status=$?
        [ "$status" -eq 0 ] || fail session-exited
        exit 0
    fi
    sleep 0.1
    attempt=$((attempt + 1))
done

fail session-startup
