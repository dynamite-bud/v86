+static int
+webgpuvirt_get_caps(struct virgl_drm_winsys *vdws,
+                    struct virgl_drm_caps *caps)
+{
+   uint8_t private_caps[912] = {0};
+   struct drm_virtgpu_get_caps args = {
+      .cap_set_id = 7,
+      .cap_set_ver = 3,
+      .addr = (uintptr_t)private_caps,
+      .size = sizeof(private_caps),
+   };
+   int ret = drmIoctl(vdws->fd, DRM_IOCTL_VIRTGPU_GET_CAPS, &args);
+   if (ret)
+      return ret;
+
+   uint32_t magic;
+   uint16_t version;
+   uint32_t feature_bits;
+   uint32_t shader_ir_bits;
+   uint32_t max_dimension;
+   memcpy(&magic, private_caps, sizeof(magic));
+   memcpy(&version, private_caps + 4, sizeof(version));
+   memcpy(&feature_bits, private_caps + 12, sizeof(feature_bits));
+   memcpy(&shader_ir_bits, private_caps + 16, sizeof(shader_ir_bits));
+   memcpy(&max_dimension, private_caps + 40, sizeof(max_dimension));
+   if (magic != 0x57363856 || version != 3 ||
+       (feature_bits & 0x5f) != 0x5f || !(shader_ir_bits & 2))
+      return -EINVAL;
+
+   memset(caps, 0, sizeof(*caps));
+   struct virgl_caps_v2 *out = &caps->caps.v2;
+   out->v1.max_version = 2;
+   out->v1.glsl_level = 430;
+   out->v1.max_texture_array_layers = 1;
+   out->v1.max_render_targets = 1;
+   out->v1.max_samples = 1;
+   out->v1.prim_mask = 1u << MESA_PRIM_TRIANGLES;
+   out->v1.max_uniform_blocks = 8;
+   out->v1.max_viewports = 1;
+   out->v1.bset.ubo = 1;
+   out->v1.bset.blend_eq_sep = 1;
+   out->v1.bset.fragment_coord_conventions = 1;
+   out->capability_bits |= VIRGL_CAP_SRGB_WRITE_CONTROL;
+   out->max_vertex_attribs = 16;
+   out->max_vertex_attrib_stride = 2048;
+   out->max_vertex_outputs = 16;
+   out->max_texture_2d_size = max_dimension;
+   out->max_texture_3d_size = 1;
+   out->max_texture_cube_size = 1;
+   out->uniform_buffer_offset_alignment = 256;
+   out->max_texture_samplers = 4;
+   out->max_const_buffer_size[MESA_SHADER_VERTEX] = 64 * 1024;
+   out->max_const_buffer_size[MESA_SHADER_FRAGMENT] = 64 * 1024;
+   out->max_uniform_block_size = 64 * 1024;
+   snprintf(out->renderer, sizeof(out->renderer), "v86 WebGPU webgpuvirt");
+
+   webgpuvirt_set_format(&out->v1.sampler, VIRGL_FORMAT_R8_UNORM);
+   webgpuvirt_set_format(&out->v1.sampler, VIRGL_FORMAT_R8G8B8A8_UNORM);
+   webgpuvirt_set_format(&out->v1.sampler, VIRGL_FORMAT_B8G8R8A8_UNORM);
+   webgpuvirt_set_format(&out->v1.sampler, VIRGL_FORMAT_B8G8R8X8_UNORM);
+   webgpuvirt_set_format(&out->v1.sampler, VIRGL_FORMAT_B8G8R8A8_SRGB);
+   webgpuvirt_set_format(&out->v1.sampler, VIRGL_FORMAT_B8G8R8X8_SRGB);
+   webgpuvirt_set_format(&out->v1.sampler, VIRGL_FORMAT_R8G8B8A8_SRGB);
+   webgpuvirt_set_format(&out->v1.render, VIRGL_FORMAT_R8G8B8A8_UNORM);
+   webgpuvirt_set_format(&out->v1.render, VIRGL_FORMAT_B8G8R8A8_UNORM);
+   webgpuvirt_set_format(&out->v1.render, VIRGL_FORMAT_B8G8R8X8_UNORM);
+   webgpuvirt_set_format(&out->v1.render, VIRGL_FORMAT_B8G8R8A8_SRGB);
+   webgpuvirt_set_format(&out->v1.render, VIRGL_FORMAT_B8G8R8X8_SRGB);
+   webgpuvirt_set_format(&out->v1.render, VIRGL_FORMAT_R8G8B8A8_SRGB);
+   webgpuvirt_set_format(&out->scanout, VIRGL_FORMAT_R8G8B8A8_UNORM);
+   webgpuvirt_set_format(&out->scanout, VIRGL_FORMAT_B8G8R8A8_UNORM);
+   webgpuvirt_set_format(&out->scanout, VIRGL_FORMAT_B8G8R8X8_UNORM);
+   webgpuvirt_set_format(&out->v1.vertexbuffer, VIRGL_FORMAT_R32_FLOAT);
+   webgpuvirt_set_format(&out->v1.vertexbuffer, VIRGL_FORMAT_R32G32_FLOAT);
+   webgpuvirt_set_format(&out->v1.vertexbuffer, VIRGL_FORMAT_R32G32B32_FLOAT);
+   webgpuvirt_set_format(&out->v1.vertexbuffer, VIRGL_FORMAT_R32G32B32A32_FLOAT);
+   webgpuvirt_set_format(&out->v1.vertexbuffer, VIRGL_FORMAT_R8G8B8A8_UNORM);
+   webgpuvirt_set_format(&out->v1.vertexbuffer, VIRGL_FORMAT_R8_UINT);
+   webgpuvirt_set_format(&out->v1.vertexbuffer, VIRGL_FORMAT_R8G8B8A8_UINT);
+   webgpuvirt_set_format(&out->v1.vertexbuffer, VIRGL_FORMAT_R16G16_UINT);
+   webgpuvirt_set_format(&out->v1.vertexbuffer, VIRGL_FORMAT_R16G16_SINT);
+   webgpuvirt_set_format(&out->v1.vertexbuffer, VIRGL_FORMAT_R32G32_UINT);
+   return 0;
+}
